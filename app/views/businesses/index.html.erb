<% content_for :title, "Empresas em Teixeira de Freitas | Accio Preço" %>
<% content_for :meta_description, "Guia de comércios, lojas físicas, oficinas e prestadores de serviços em Teixeira de Freitas - BA." %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Empresas e Profissionais Locais</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">Conheça os estabelecimentos comerciais e autônomos de Teixeira de Freitas</p>
    </div>

    <%= link_to search_path(type: "empresas"), class: "inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-indigo-50 text-indigo-700 hover:bg-indigo-100 text-xs font-bold transition" do %>
      <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <span>Pesquisar empresas</span>
    <% end %>
  </div>

  <% if @businesses.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <% @businesses.each do |business| %>
        <%= render "shared/business_card", business: business %>
      <% end %>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <%= render "shared/empty_state", title: "Nenhuma empresa cadastrada no momento", message: "Em breve novas empresas parceiras estarão cadastradas." %>
  <% end %>
</div>
