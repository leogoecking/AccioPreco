<% content_for :title, "#{@business.name} em Teixeira de Freitas | Accio Preço" %>
<% content_for :meta_description, "#{@business.name} em Teixeira de Freitas - BA. Veja produtos, serviços e entre em contato direto via WhatsApp." %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
  <!-- Breadcrumb -->
  <div class="mb-6 flex items-center gap-2 text-xs text-slate-500">
    <%= link_to "Início", root_path, class: "hover:text-indigo-600 transition" %>
    <span>/</span>
    <%= link_to "Empresas", businesses_path, class: "hover:text-indigo-600 transition" %>
    <span>/</span>
    <span class="font-bold text-slate-800 truncate"><%= @business.name %></span>
  </div>

  <!-- Business Header Profile Card -->
  <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-xs mb-10">
    <% if @business.banner.attached? %>
      <div class="h-36 sm:h-56 w-full overflow-hidden bg-slate-100 relative">
        <%= image_tag @business.banner, class: "w-full h-full object-cover", alt: "Banner de #{@business.name}" %>
      </div>
    <% end %>

    <div class="p-6 sm:p-8 <%= '-mt-10 sm:-mt-14' if @business.banner.attached? %> relative">
      <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
        <div class="flex items-start gap-4">
          <!-- Logo / Initials -->
          <% if @business.logo.attached? %>
            <%= image_tag @business.logo, class: "w-16 h-16 sm:w-20 sm:h-20 rounded-2xl object-cover border-4 border-white bg-white shrink-0 shadow-md shadow-slate-200", alt: "Logo de #{@business.name}" %>
          <% else %>
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br from-indigo-600 to-indigo-800 text-white flex items-center justify-center font-black text-2xl sm:text-3xl shrink-0 shadow-md shadow-indigo-200 border-4 border-white">
              <%= @business.name[0..1].upcase %>
            </div>
          <% end %>

          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-2xl sm:text-3xl font-black text-slate-900"><%= @business.name %></h1>
              <% if @business.verified? %>
                <span class="inline-flex items-center gap-1 text-xs font-bold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
                  <svg class="w-3.5 h-3.5 text-emerald-600 fill-current" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  Verificado
                </span>
              <% end %>
            </div>

            <p class="text-xs font-semibold text-slate-500 mt-1">
              <%= @business.business_type == 'store' ? 'Loja de Produtos' : (@business.business_type == 'service_provider' ? 'Prestador de Serviços' : 'Loja & Prestador de Serviços') %>
              · <%= @business.neighborhood.presence || "Centro" %>, <%= @business.city %> - <%= @business.state %>
            </p>

            <p class="text-sm text-slate-600 mt-3 max-w-2xl leading-relaxed">
              <%= @business.description %>
            </p>

          <div class="mt-4 flex flex-wrap items-center gap-y-2 gap-x-4 text-xs text-slate-500">
            <% if @business.full_address.present? %>
              <span class="flex items-center gap-1">
                📍 <%= @business.full_address %>
              </span>
            <% end %>
            <% if @business.phone.present? %>
              <span class="flex items-center gap-1">
                📞 <%= @business.phone %>
              </span>
            <% end %>
            <% if @business.instagram_url.present? %>
              <a href="<%= @business.instagram_url %>" target="_blank" rel="noopener" class="flex items-center gap-1 text-indigo-600 hover:text-indigo-800 font-medium transition">
                📸 <%= @business.instagram_handle %>
              </a>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-col sm:flex-row md:flex-col gap-2 shrink-0">
        <% if @business.whatsapp.present? %>
          <%= link_to whatsapp_click_path(business_id: @business.id),
            target: "_blank",
            rel: "noopener",
            data: { turbo: false },
            class: "px-6 py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm flex items-center justify-center gap-2 shadow-md shadow-emerald-200 transition" do %>
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.585 1.961.879 2.796.88h.005c3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.586-5.767-5.773-5.767zm3.376 8.232c-.144.405-.837.775-1.17.824-.312.045-.718.067-2.146-.525-1.826-.757-3.003-2.617-3.094-2.738-.091-.122-.74-1.026-.74-1.956 0-.931.488-1.389.66-1.58.173-.191.376-.239.502-.239.126 0 .252.001.362.007.116.006.27-.044.422.324.156.377.534 1.306.58 1.401.047.095.078.207.016.332-.063.125-.094.203-.187.312-.093.11-.197.245-.281.33-.094.094-.192.197-.082.386.11.19.489.807 1.05 1.306.722.643 1.331.842 1.52.937.19.094.3.079.412-.047.112-.126.48-.56.608-.752.128-.192.257-.16.432-.095.176.064 1.117.527 1.31.624.192.096.321.144.368.224.047.079.047.46-.097.865z"/>
            </svg>
            <span>Falar no WhatsApp</span>
          <% end %>
        <% end %>

        <% if @business.phone.present? %>
          <a href="tel:<%= @business.phone %>" class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-xs flex items-center justify-center gap-2 transition">
            <span>📞 Ligar agora</span>
          </a>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Products Section -->
  <% if @products.any? %>
    <div class="mb-14">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900">
          Produtos disponíveis (<%= @products.count %>)
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @products.each do |product| %>
          <%= render "shared/product_card", product: product %>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Services Section -->
  <% if @services.any? %>
    <div>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900">
          Serviços prestados (<%= @services.count %>)
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @services.each do |service| %>
          <%= render "shared/service_card", service: service %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @products.empty? && @services.empty? %>
    <div class="text-center py-12 px-6 bg-white rounded-3xl border border-slate-200 text-slate-500 text-xs shadow-2xs">
      <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3 text-lg">📦</div>
      <p class="font-bold text-slate-700 text-sm mb-1">Catálogo em atualização</p>
      <p class="max-w-md mx-auto leading-relaxed">Este estabelecimento ainda não possui itens cadastrados no catálogo online. Entre em contato pelo WhatsApp para consultar produtos ou solicitar serviços.</p>
    </div>
  <% end %>
</div>
