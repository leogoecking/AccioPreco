<% content_for :title, "#{@business.name} | Accio Preço" %>
<% content_for :meta_description, "#{@business.name} em Teixeira de Freitas - BA. Veja produtos, serviços e entre em contato direto." %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to "← Voltar às empresas", businesses_path, class: "text-sm text-indigo-600 font-semibold hover:underline" %>
  </div>

  <!-- Business Header Profile Card -->
  <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-xs mb-10">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
      <div class="flex items-start gap-4">
        <div class="w-16 h-16 rounded-2xl bg-indigo-600 text-white flex items-center justify-center font-black text-2xl shrink-0 shadow-md shadow-indigo-200">
          <%= @business.name[0..1].upcase %>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900"><%= @business.name %></h1>
            <% if @business.verified? %>
              <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                Verificado
              </span>
            <% end %>
          </div>
          <p class="text-xs font-semibold text-slate-500 mt-1">
            <%= @business.business_type == 'store' ? 'Loja de Produtos' : (@business.business_type == 'service_provider' ? 'Prestador de Serviços' : 'Loja & Serviços') %>
            · <%= @business.city %> - <%= @business.state %>
          </p>
          <p class="text-sm text-slate-600 mt-3 max-w-2xl leading-relaxed">
            <%= @business.description %>
          </p>

          <div class="mt-4 flex flex-wrap items-center gap-y-2 gap-x-4 text-xs text-slate-500">
            <% if @business.full_address.present? %>
              <span class="flex items-center gap-1">
                📍 <%= @business.full_address %>
              </span>
            <% end %>
            <% if @business.phone.present? %>
              <span class="flex items-center gap-1">
                📞 <%= @business.phone %>
              </span>
            <% end %>
            <% if @business.instagram.present? %>
              <span class="flex items-center gap-1">
                📸 <%= @business.instagram %>
              </span>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-col sm:flex-row md:flex-col gap-2 shrink-0">
        <% if @business.whatsapp.present? %>
          <%= link_to @business.whatsapp_url(text: "Olá! Vi a #{@business.name} no Accio Preço e gostaria de atendimento."), target: "_blank", rel: "noopener", class: "px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm flex items-center justify-center gap-2 shadow-sm transition" do %>
            <span>Falar no WhatsApp</span>
          <% end %>
        <% end %>
        <% if @business.phone.present? %>
          <a href="tel:<%= @business.phone %>" class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-xs flex items-center justify-center gap-2 transition">
            <span>Ligar agora</span>
          </a>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Products Section -->
  <% if @products.any? %>
    <div class="mb-12">
      <h2 class="text-2xl font-black text-slate-900 mb-6">Produtos disponíveis (<%= @products.count %>)</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @products.each do |product| %>
          <div class="bg-white rounded-2xl border border-slate-200 p-5 flex flex-col justify-between shadow-xs">
            <div>
              <div class="flex justify-between items-center mb-2">
                <span class="text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-slate-100 text-slate-600">
                  <%= product.category.name %>
                </span>
                <% if product.on_sale? %>
                  <span class="text-[11px] font-bold px-1.5 py-0.5 rounded-md bg-rose-50 text-rose-700">
                    -<%= product.discount_percentage %>%
                  </span>
                <% end %>
              </div>
              <h3 class="font-bold text-slate-900"><%= link_to product.name, product_path(product), class: "hover:text-indigo-600" %></h3>
              <p class="text-xs text-slate-600 mt-1 line-clamp-2"><%= product.description %></p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
              <span class="text-lg font-black text-slate-950">R$ <%= '%.2f' % product.current_price %></span>
              <% if @business.whatsapp.present? %>
                <%= link_to "WhatsApp", @business.whatsapp_url(text: "Olá! Tenho interesse no produto #{product.name}"), target: "_blank", class: "text-xs font-bold text-emerald-600 hover:underline" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Services Section -->
  <% if @services.any? %>
    <div>
      <h2 class="text-2xl font-black text-slate-900 mb-6">Serviços oferecidos (<%= @services.count %>)</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @services.each do |service| %>
          <div class="bg-white rounded-2xl border border-slate-200 p-5 flex flex-col justify-between shadow-xs">
            <div>
              <div class="flex justify-between items-center mb-2">
                <span class="text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700">
                  <%= service.category.name %>
                </span>
                <% if service.home_service? %>
                  <span class="text-[11px] font-semibold text-emerald-700">🏠 A Domicílio</span>
                <% end %>
              </div>
              <h3 class="font-bold text-slate-900"><%= link_to service.name, service_path(service), class: "hover:text-indigo-600" %></h3>
              <p class="text-xs text-slate-600 mt-1 line-clamp-2"><%= service.description %></p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
              <span class="text-sm font-bold text-indigo-700"><%= service.formatted_price %></span>
              <% if @business.whatsapp.present? %>
                <%= link_to "Orçamento", @business.whatsapp_url(text: "Olá! Gostaria de orçamento para #{service.name}"), target: "_blank", class: "text-xs font-bold text-emerald-600 hover:underline" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
