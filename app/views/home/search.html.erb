<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <%= link_to "← Voltar ao início", root_path, class: "text-sm text-indigo-600 font-semibold hover:underline" %>
    <h1 class="text-2xl sm:text-3xl font-black text-slate-900 mt-2">
      Busca: <span class="text-indigo-600">"<%= @query %>"</span>
    </h1>
    <p class="text-sm text-slate-500">Resultados encontrados no comércio de Teixeira de Freitas</p>
  </div>

  <!-- Search input bar -->
  <div class="mb-10 max-w-2xl">
    <%= form_with url: search_path, method: :get, class: "flex gap-2" do |f| %>
      <%= f.text_field :q, value: @query, placeholder: "Buscar produtos, serviços ou empresas...", class: "flex-grow px-4 py-3 bg-white rounded-xl border border-slate-300 text-sm focus:outline-indigo-500" %>
      <%= f.submit "Buscar", class: "px-5 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-sm transition" %>
    <% end %>
  </div>

  <% if @products.empty? && @services.empty? && @businesses.empty? %>
    <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center max-w-lg mx-auto">
      <div class="text-4xl mb-3">🔍</div>
      <h3 class="text-lg font-bold text-slate-800">Nenhum resultado encontrado</h3>
      <p class="text-sm text-slate-500 mt-1 mb-4">Não encontramos produtos, serviços ou empresas com o termo buscado.</p>
      <%= link_to "Ver todos os produtos", products_path, class: "text-xs font-bold text-indigo-600 hover:underline" %>
    </div>
  <% else %>
    <!-- Products results -->
    <% if @products.any? %>
      <div class="mb-10">
        <h2 class="text-xl font-bold text-slate-900 mb-4">Produtos (<%= @products.count %>)</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @products.each do |product| %>
            <div class="bg-white p-5 rounded-2xl border border-slate-200 flex flex-col justify-between">
              <div>
                <h3 class="font-bold text-slate-900"><%= link_to product.name, product_path(product), class: "hover:text-indigo-600" %></h3>
                <p class="text-xs text-slate-500 mt-0.5"><%= product.business.name %></p>
                <p class="text-xs text-slate-600 mt-2 line-clamp-2"><%= product.description %></p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                <span class="text-base font-extrabold text-slate-900">R$ <%= '%.2f' % product.current_price %></span>
                <% if product.business.whatsapp.present? %>
                  <%= link_to "WhatsApp", product.business.whatsapp_url(text: "Olá! Vi #{product.name} no Accio Preço."), target: "_blank", class: "text-xs font-bold text-emerald-600 hover:underline" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Services results -->
    <% if @services.any? %>
      <div class="mb-10">
        <h2 class="text-xl font-bold text-slate-900 mb-4">Serviços (<%= @services.count %>)</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @services.each do |service| %>
            <div class="bg-white p-5 rounded-2xl border border-slate-200 flex flex-col justify-between">
              <div>
                <h3 class="font-bold text-slate-900"><%= link_to service.name, service_path(service), class: "hover:text-indigo-600" %></h3>
                <p class="text-xs text-slate-500 mt-0.5"><%= service.business.name %></p>
                <p class="text-xs text-slate-600 mt-2 line-clamp-2"><%= service.description %></p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                <span class="text-sm font-bold text-indigo-700"><%= service.formatted_price %></span>
                <% if service.business.whatsapp.present? %>
                  <%= link_to "WhatsApp", service.business.whatsapp_url(text: "Olá! Vi #{service.name} no Accio Preço."), target: "_blank", class: "text-xs font-bold text-emerald-600 hover:underline" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Businesses results -->
    <% if @businesses.any? %>
      <div class="mb-10">
        <h2 class="text-xl font-bold text-slate-900 mb-4">Empresas (<%= @businesses.count %>)</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @businesses.each do |business| %>
            <div class="bg-white p-5 rounded-2xl border border-slate-200">
              <h3 class="font-bold text-slate-900"><%= link_to business.name, business_path(business), class: "hover:text-indigo-600" %></h3>
              <p class="text-xs text-slate-500 mt-0.5"><%= business.neighborhood.presence || business.city %></p>
              <p class="text-xs text-slate-600 mt-2 line-clamp-2"><%= business.description %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
