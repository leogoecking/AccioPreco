<!-- Hero Section -->
<section class="relative overflow-hidden bg-gradient-to-b from-indigo-50/70 via-white to-slate-50 py-12 sm:py-20 border-b border-slate-200/60">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <!-- Hyperlocal City Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-indigo-100/80 text-indigo-800 mb-6 shadow-2xs">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>Buscador Hiperlocal · Teixeira de Freitas - BA</span>
    </div>

    <!-- Main Title -->
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-950 leading-[1.1]">
      Accio<span class="text-indigo-600">Preço</span>: O que você precisa em <br class="hidden sm:inline">
      <span class="text-indigo-600 underline decoration-indigo-200 decoration-wavy decoration-from-font">Teixeira de Freitas?</span>
    </h1>

    <p class="mt-4 text-base sm:text-lg text-slate-600 font-medium max-w-2xl mx-auto">
      Encontre produtos, serviços, oficinas, especialistas e comércios locais em segundos. Chame direto no WhatsApp.
    </p>

    <!-- Search Form Hero -->
    <div class="mt-8 max-w-2xl mx-auto">
      <%= render "shared/search_bar", compact: false, show_suggestions: true %>
    </div>
  </div>
</section>

<!-- Fast Navigation Badges & Categories -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <!-- Top 3 Quick Portals -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
    <%= link_to products_path, class: "flex items-center gap-3 p-4 rounded-2xl bg-white border border-slate-200 hover:border-indigo-400 hover:shadow-md text-slate-800 transition group shadow-2xs" do %>
      <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl shrink-0 group-hover:scale-110 transition">📦</div>
      <div>
        <h3 class="font-bold text-slate-900 group-hover:text-indigo-600 transition text-sm">Produtos Locais</h3>
        <p class="text-xs text-slate-500">Eletrônicos, casa, peças e mais</p>
      </div>
    <% end %>

    <%= link_to services_path, class: "flex items-center gap-3 p-4 rounded-2xl bg-white border border-slate-200 hover:border-indigo-400 hover:shadow-md text-slate-800 transition group shadow-2xs" do %>
      <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl shrink-0 group-hover:scale-110 transition">🛠️</div>
      <div>
        <h3 class="font-bold text-slate-900 group-hover:text-indigo-600 transition text-sm">Serviços & Profissionais</h3>
        <p class="text-xs text-slate-500">Técnicos, eletricistas, reparos</p>
      </div>
    <% end %>

    <%= link_to businesses_path, class: "flex items-center gap-3 p-4 rounded-2xl bg-white border border-slate-200 hover:border-indigo-400 hover:shadow-md text-slate-800 transition group shadow-2xs" do %>
      <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0 group-hover:scale-110 transition">🏢</div>
      <div>
        <h3 class="font-bold text-slate-900 group-hover:text-indigo-600 transition text-sm">Guia de Empresas</h3>
        <p class="text-xs text-slate-500">Lojas físicas e estabelecimentos</p>
      </div>
    <% end %>
  </div>

  <!-- Popular Category Pills -->
  <% if @categories.any? %>
    <div class="text-center">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Categorias Populares</h2>
      <div class="flex flex-wrap items-center justify-center gap-2">
        <% @categories.each do |category| %>
          <%= link_to category_path(category), class: "inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white border border-slate-200 hover:border-indigo-500 hover:text-indigo-600 hover:shadow-xs text-slate-700 transition" do %>
            <span><%= category.name %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</section>

<!-- Featured Products Section -->
<% if @featured_products.any? %>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight">Produtos em Destaque</h2>
        <p class="text-xs sm:text-sm text-slate-500">Disponíveis hoje no comércio de Teixeira de Freitas</p>
      </div>
      <%= link_to "Ver todos os produtos →", products_path, class: "text-xs sm:text-sm font-bold text-indigo-600 hover:text-indigo-800" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @featured_products.each do |product| %>
        <%= render "shared/product_card", product: product %>
      <% end %>
    </div>
  </section>
<% end %>

<!-- Featured Services Section -->
<% if @featured_services.any? %>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight">Serviços e Especialistas</h2>
        <p class="text-xs sm:text-sm text-slate-500">Profissionais qualificados para atendimento presencial ou a domicílio</p>
      </div>
      <%= link_to "Ver todos os serviços →", services_path, class: "text-xs sm:text-sm font-bold text-indigo-600 hover:text-indigo-800" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @featured_services.each do |service| %>
        <%= render "shared/service_card", service: service %>
      <% end %>
    </div>
  </section>
<% end %>

<!-- Local Businesses Section -->
<% if @businesses.any? %>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight">Empresas e Profissionais Locais</h2>
        <p class="text-xs sm:text-sm text-slate-500">Comércios e oficinas credenciadas em bairros da cidade</p>
      </div>
      <%= link_to "Ver todas as empresas →", businesses_path, class: "text-xs sm:text-sm font-bold text-indigo-600 hover:text-indigo-800" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <% @businesses.each do |business| %>
        <%= render "shared/business_card", business: business %>
      <% end %>
    </div>
  </section>
<% end %>

<!-- Trust / Social Proof Banner -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="bg-indigo-50/70 border border-indigo-100 rounded-3xl p-6 sm:p-8">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
      <div>
        <div class="w-10 h-10 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center mx-auto mb-2 text-lg">⚡</div>
        <h4 class="font-bold text-slate-900 text-sm">Busca Hiperlocal Rápida</h4>
        <p class="text-xs text-slate-500 mt-1">Pesquise o que precisa e saiba quem tem disponível agora em Teixeira.</p>
      </div>
      <div>
        <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-2 text-lg">💬</div>
        <h4 class="font-bold text-slate-900 text-sm">Contato Direto no WhatsApp</h4>
        <p class="text-xs text-slate-500 mt-1">Sem intermediação ou cadastros burocráticos. Fale direto com o dono.</p>
      </div>
      <div>
        <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center mx-auto mb-2 text-lg">🤝</div>
        <h4 class="font-bold text-slate-900 text-sm">Fortaleça o Comércio Local</h4>
        <p class="text-xs text-slate-500 mt-1">Descubra negócios e prestadores de serviços do seu próprio bairro.</p>
      </div>
    </div>
  </div>
</section>

<!-- Merchant Call to Action -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="bg-gradient-to-br from-indigo-950 via-indigo-900 to-slate-900 rounded-3xl p-8 sm:p-12 text-white shadow-xl">
    <div class="max-w-2xl">
      <span class="text-xs font-bold uppercase tracking-wider text-indigo-300">Para comerciantes e profissionais autônomos</span>
      <h2 class="text-3xl sm:text-4xl font-black tracking-tight mt-2 mb-4">
        Sua empresa já está no Accio Preço?
      </h2>
      <p class="text-indigo-200 text-sm sm:text-base leading-relaxed mb-6">
        Cadastre seus produtos e serviços gratuitamente e receba mensagens no seu WhatsApp sempre que alguém buscar pelo que você oferece em Teixeira de Freitas.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <%= link_to "Cadastrar minha empresa", login_path, class: "inline-flex items-center px-6 py-3.5 rounded-xl bg-white hover:bg-slate-100 text-indigo-950 font-extrabold text-sm sm:text-base shadow-lg transition" %>
        <span class="text-xs text-indigo-300">Sem taxas por venda · Contato 100% direto</span>
      </div>
    </div>
  </div>
</section>
