<%# Product Card Component
  Locals:
    product: Product instance
%>
<div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-md hover:border-indigo-300 transition duration-200 flex flex-col justify-between group">
  <div>
    <!-- Image / Placeholder -->
    <div class="relative bg-slate-100 aspect-square w-full flex items-center justify-center overflow-hidden">
      <% if product.respond_to?(:images) && product.images.attached? %>
        <%= image_tag product.images.first, class: "w-full h-full object-cover group-hover:scale-105 transition duration-300", alt: product.name, loading: "lazy" %>
      <% else %>
        <div class="text-slate-300 flex flex-col items-center justify-center p-4">
          <svg class="w-12 h-12 stroke-1 text-slate-300 group-hover:text-indigo-300 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span class="text-[10px] font-medium text-slate-400 mt-1">Foto na loja</span>
        </div>
      <% end %>

      <!-- Sale Badge -->
      <% if product.on_sale? %>
        <span class="absolute top-2 left-2 text-[11px] font-black px-2 py-0.5 rounded-lg bg-rose-600 text-white shadow-sm">
          -<%= product.discount_percentage %>% OFF
        </span>
      <% end %>

      <!-- Category Pill -->
      <span class="absolute top-2 right-2 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-white/90 backdrop-blur text-slate-700 shadow-2xs border border-slate-200/60">
        <%= product.category.name %>
      </span>
    </div>

    <!-- Content -->
    <div class="p-4">
      <h3 class="font-bold text-slate-900 text-sm sm:text-base line-clamp-2 leading-snug group-hover:text-indigo-600 transition">
        <%= link_to product.name, product_path(product) %>
      </h3>

      <!-- Business info -->
      <div class="mt-2 flex items-center gap-1.5 text-xs text-slate-500">
        <% if product.business.logo.attached? %>
          <%= image_tag product.business.logo, class: "w-4 h-4 rounded-full object-cover border border-slate-200 bg-white shrink-0", alt: product.business.name %>
        <% else %>
          <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5"/>
          </svg>
        <% end %>
        <span class="truncate font-medium text-slate-700">
          <%= link_to product.business.name, business_path(product.business), class: "hover:underline" %>
        </span>
        <% if product.business.neighborhood.present? %>
          <span class="text-slate-300">·</span>
          <span class="truncate text-slate-500"><%= product.business.neighborhood %></span>
        <% end %>
      </div>

      <% if product.description.present? %>
        <p class="mt-2 text-xs text-slate-600 line-clamp-2 leading-relaxed">
          <%= product.description %>
        </p>
      <% end %>
    </div>
  </div>

  <!-- Bottom Price & CTA -->
  <div class="px-4 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between gap-2">
    <div>
      <% if product.on_sale? %>
        <p class="text-[11px] text-slate-400 line-through"><%= format_currency(product.price) %></p>
      <% end %>
      <div class="text-base sm:text-lg font-black text-slate-950">
        <%= format_currency(product.current_price) %>
      </div>
    </div>

    <% if product.business.whatsapp.present? %>
      <%= link_to whatsapp_click_path(business_id: product.business_id, product_id: product.id),
        target: "_blank",
        rel: "noopener",
        data: { turbo: false },
        class: "inline-flex items-center gap-1 px-3 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-xs transition shrink-0",
        title: "Chamar no WhatsApp" do %>
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.585 1.961.879 2.796.88h.005c3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.586-5.767-5.773-5.767zm3.376 8.232c-.144.405-.837.775-1.17.824-.312.045-.718.067-2.146-.525-1.826-.757-3.003-2.617-3.094-2.738-.091-.122-.74-1.026-.74-1.956 0-.931.488-1.389.66-1.58.173-.191.376-.239.502-.239.126 0 .252.001.362.007.116.006.27-.044.422.324.156.377.534 1.306.58 1.401.047.095.078.207.016.332-.063.125-.094.203-.187.312-.093.11-.197.245-.281.33-.094.094-.192.197-.082.386.11.19.489.807 1.05 1.306.722.643 1.331.842 1.52.937.19.094.3.079.412-.047.112-.126.48-.56.608-.752.128-.192.257-.16.432-.095.176.064 1.117.527 1.31.624.192.096.321.144.368.224.047.079.047.46-.097.865z"/>
        </svg>
        <span>WhatsApp</span>
      <% end %>
    <% else %>
      <%= link_to "Ver", product_path(product), class: "text-xs font-bold text-indigo-600 hover:text-indigo-800" %>
    <% end %>
  </div>
</div>
