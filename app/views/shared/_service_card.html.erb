<%# Service Card Component
  Locals:
    service: Service instance
%>
<div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs hover:shadow-md hover:border-indigo-300 transition duration-200 flex flex-col justify-between group">
  <div>
    <!-- Badges -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700">
        <%= service.category.name %>
      </span>

      <% if service.home_service? %>
        <span class="inline-flex items-center gap-1 text-[11px] font-semibold px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200/60">
          <span>🏠</span> A Domicílio
        </span>
      <% else %>
        <span class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-slate-100 text-slate-600">
          No local
        </span>
      <% end %>
    </div>

    <!-- Title & Provider -->
    <h3 class="font-bold text-slate-900 text-base leading-snug group-hover:text-indigo-600 transition">
      <%= link_to service.name, service_path(service) %>
    </h3>

    <div class="mt-2 flex items-center gap-1.5 text-xs text-slate-500">
      <% if service.business.logo.attached? %>
        <%= image_tag service.business.logo, class: "w-4 h-4 rounded-full object-cover border border-slate-200 bg-white shrink-0", alt: service.business.name %>
      <% else %>
        <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      <% end %>
      <span class="truncate font-medium text-slate-700">
        <%= link_to service.business.name, business_path(service.business), class: "hover:underline" %>
      </span>
      <% if service.business.neighborhood.present? %>
        <span class="text-slate-300">·</span>
        <span class="truncate text-slate-500"><%= service.business.neighborhood %></span>
      <% end %>
    </div>

    <!-- Description -->
    <p class="mt-3 text-xs text-slate-600 line-clamp-3 leading-relaxed">
      <%= service.description %>
    </p>
  </div>

  <!-- Bottom Price & Actions -->
  <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between gap-2">
    <div>
      <span class="text-xs text-slate-400 block font-medium">Estimativa</span>
      <span class="text-sm sm:text-base font-extrabold text-indigo-700">
        <%= service.formatted_price %>
      </span>
    </div>

    <div class="flex items-center gap-1.5 shrink-0">
      <%= link_to service_path(service, anchor: "orcamento"), class: "px-2.5 py-1.5 rounded-lg border border-indigo-200 text-indigo-700 hover:bg-indigo-50 text-xs font-semibold transition" do %>
        Orçamento
      <% end %>

      <% if service.business.whatsapp.present? %>
        <%= link_to whatsapp_click_path(business_id: service.business_id, service_id: service.id),
          target: "_blank",
          rel: "noopener",
          data: { turbo: false },
          class: "inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-xs transition",
          title: "Chamar no WhatsApp" do %>
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.585 1.961.879 2.796.88h.005c3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.586-5.767-5.773-5.767zm3.376 8.232c-.144.405-.837.775-1.17.824-.312.045-.718.067-2.146-.525-1.826-.757-3.003-2.617-3.094-2.738-.091-.122-.74-1.026-.74-1.956 0-.931.488-1.389.66-1.58.173-.191.376-.239.502-.239.126 0 .252.001.362.007.116.006.27-.044.422.324.156.377.534 1.306.58 1.401.047.095.078.207.016.332-.063.125-.094.203-.187.312-.093.11-.197.245-.281.33-.094.094-.192.197-.082.386.11.19.489.807 1.05 1.306.722.643 1.331.842 1.52.937.19.094.3.079.412-.047.112-.126.48-.56.608-.752.128-.192.257-.16.432-.095.176.064 1.117.527 1.31.624.192.096.321.144.368.224.047.079.047.46-.097.865z"/>
          </svg>
          <span>WhatsApp</span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
