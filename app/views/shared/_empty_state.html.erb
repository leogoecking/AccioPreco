<%# Empty State Component
  Locals:
    query: string (optional)
    title: string (default: "Nenhum resultado encontrado")
    message: string (optional)
    show_categories: boolean (default: true)
%>
<% query = local_assigns[:query].presence %>
<% title = local_assigns.fetch(:title, query ? "Nenhum resultado encontrado para \"#{query}\"" : "Nenhum item encontrado") %>
<% message = local_assigns.fetch(:message, "Tente buscar por termos mais genéricos, verificar a ortografia ou navegar pelas categorias abaixo.") %>
<% show_categories = local_assigns.fetch(:show_categories, true) %>

<div class="text-center py-12 px-4 sm:px-6 bg-white rounded-3xl border border-slate-200 shadow-2xs max-w-2xl mx-auto my-8">
  <div class="w-16 h-16 rounded-2xl bg-indigo-50 border border-indigo-100 text-indigo-500 flex items-center justify-center mx-auto mb-4">
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
    </svg>
  </div>

  <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2">
    <%= title %>
  </h3>

  <p class="text-sm text-slate-500 max-w-md mx-auto leading-relaxed mb-6">
    <%= message %>
  </p>

  <div class="flex flex-wrap items-center justify-center gap-2 mb-8">
    <span class="text-xs font-semibold text-slate-400">Sugestões de busca:</span>
    <%= link_to "Copo térmico", search_path(q: "copo térmico"), class: "text-xs px-3 py-1 rounded-lg bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 transition" %>
    <%= link_to "Ar-condicionado", search_path(q: "ar-condicionado"), class: "text-xs px-3 py-1 rounded-lg bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 transition" %>
    <%= link_to "Eletricista", search_path(q: "eletricista"), class: "text-xs px-3 py-1 rounded-lg bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 transition" %>
    <%= link_to "Ração", search_path(q: "ração"), class: "text-xs px-3 py-1 rounded-lg bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 transition" %>
  </div>

  <% if show_categories && defined?(@categories) && @categories.present? %>
    <div class="pt-6 border-t border-slate-100">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">Ou explore por categorias</p>
      <div class="flex flex-wrap justify-center gap-2">
        <% @categories.first(6).each do |category| %>
          <%= link_to category.name, category_path(category), class: "text-xs px-3 py-1.5 rounded-full bg-slate-50 border border-slate-200 text-slate-600 hover:border-indigo-400 hover:text-indigo-600 transition" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mt-6">
    <%= link_to "Ver todos os produtos e serviços", search_path, class: "inline-flex items-center gap-1.5 text-xs font-bold text-indigo-600 hover:text-indigo-800" %>
  </div>
</div>
