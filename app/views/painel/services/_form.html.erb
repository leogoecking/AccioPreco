<%= form_with model: [:painel, service], local: true, class: "space-y-6" do |f| %>
  <% if service.errors.any? %>
    <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm">
      <h3 class="font-bold mb-1">Corrija os erros abaixo:</h3>
      <ul class="list-disc list-inside text-xs space-y-0.5">
        <% service.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4">
    <div>
      <%= f.label :name, "Nome do Serviço *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_field :name, required: true, placeholder: "Ex: Limpeza e Higienização de Ar-condicionado Split", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :category_id, "Categoria *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.collection_select :category_id, Category.active.for_services.order(:name), :id, :name, { prompt: "Selecione a categoria" }, required: true, class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-white" %>
      </div>

      <div>
        <%= f.label :starting_price, "Preço Inicial Estimado (R$)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.number_field :starting_price, step: "0.01", min: "0", placeholder: "150.00", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :price_description, "Descrição do Preço (ex: A partir de R$ 150)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.text_field :price_description, placeholder: "Ex: A partir de R$ 150 ou Sob Consulta", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>

      <div class="flex flex-col justify-center space-y-2 pt-2">
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :home_service, class: "w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500" %>
          <span class="text-xs font-bold text-slate-700">Atendimento a domicílio / no local</span>
        </label>

        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :featured, class: "w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500" %>
          <span class="text-xs font-bold text-slate-700">Destacar este serviço</span>
        </label>

        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :active, class: "w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500" %>
          <span class="text-xs font-bold text-slate-700">Serviço ativo para contratação</span>
        </label>
      </div>
    </div>

    <div>
      <%= f.label :description, "Descrição do Serviço", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_area :description, rows: 4, placeholder: "Explique o que está incluso, tempo médio de execução, formas de pagamento, garantias...", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>
  </div>

  <div class="pt-6 border-t border-slate-200 flex items-center justify-end gap-3">
    <%= link_to "Cancelar", painel_services_path, class: "px-4 py-2 text-sm font-semibold text-slate-600 hover:text-slate-900" %>
    <%= f.submit service.persisted? ? "Salvar Alterações" : "Cadastrar Serviço", class: "px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm rounded-xl shadow-sm transition cursor-pointer" %>
  </div>
<% end %>
