<%= form_with model: [:painel, service], local: true, class: "space-y-6" do |f| %>
  <% if service.errors.any? %>
    <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm">
      <h3 class="font-bold mb-1">Corrija os erros abaixo:</h3>
      <ul class="list-disc list-inside text-xs space-y-0.5">
        <% service.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-5">
    <div>
      <%= f.label :name, "Nome do Serviço *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_field :name, required: true, placeholder: "Ex: Higienização e Manutenção de Ar-condicionado Split", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      <p class="text-[11px] text-slate-400 mt-1">Descreva o serviço com clareza para facilitar as buscas dos moradores da cidade.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :category_id, "Categoria do Serviço *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.collection_select :category_id, Category.active.for_services.order(:name), :id, :name, { prompt: "Selecione a categoria" }, required: true, class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-white" %>
      </div>

      <div>
        <%= f.label :starting_price, "Preço Inicial Estimado (R$)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.text_field :starting_price, value: service.starting_price.present? ? ('%.2f' % service.starting_price).tr('.', ',') : nil, placeholder: "Ex: 150,00", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
        <p class="text-[11px] text-slate-400 mt-1">Opcional. Se não tiver valor fixo, você pode deixar vazio e preencher a descrição abaixo.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :price_description, "Descrição do Preço (ex: A partir de R$ 150 ou Sob Orçamento)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.text_field :price_description, placeholder: "Ex: A partir de R$ 150 ou Sob Consulta", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
        <p class="text-[11px] text-slate-400 mt-1">Texto exibido diretamente para o cliente no cartão do serviço.</p>
      </div>

      <div class="space-y-3 pt-2">
        <label class="flex items-center gap-2.5 cursor-pointer select-none">
          <%= f.check_box :home_service, class: "w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300 cursor-pointer" %>
          <div>
            <span class="text-xs font-bold text-slate-800">Atendimento a domicílio / no local</span>
            <p class="text-[11px] text-slate-500">Marque se você vai até a residência ou empresa do cliente.</p>
          </div>
        </label>

        <label class="flex items-center gap-2.5 cursor-pointer select-none">
          <%= f.check_box :active, class: "w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300 cursor-pointer" %>
          <div>
            <span class="text-xs font-bold text-slate-800">Serviço ativo para contratação</span>
            <p class="text-[11px] text-slate-500">Se desmarcado, fica pausado e não aparece na busca.</p>
          </div>
        </label>
      </div>
    </div>

    <div>
      <%= f.label :description, "Descrição Completa do Serviço", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_area :description, rows: 4, placeholder: "Explique como funciona o serviço, tempo médio de realização, se o material está incluso, garantia oferecida...", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <!-- Images Section -->
    <div class="border-t border-slate-200 pt-5 space-y-3">
      <div>
        <%= f.label :images, "Fotos de Trabalhos Realizados", class: "block text-xs font-bold uppercase tracking-wider text-slate-700" %>
        <p class="text-[11px] text-slate-400 mt-0.5">Fotos de serviços anteriores comprovam sua qualidade e geram confiança</p>
      </div>

      <!-- Attached Images Grid -->
      <% if service.images.attached? %>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <% service.images.each do |image| %>
            <div class="relative group rounded-xl border border-slate-200 overflow-hidden bg-slate-50">
              <%= image_tag image, class: "w-full h-28 object-cover" %>
              <div class="p-1.5 bg-white border-t border-slate-100 flex items-center justify-between">
                <span class="text-[10px] text-slate-400 truncate"><%= image.filename %></span>
                <% if service.persisted? %>
                  <%= link_to purge_image_painel_service_path(service, image_id: image.id), data: { turbo_method: :delete, turbo_confirm: "Deseja remover esta foto do serviço?" }, class: "text-[11px] font-bold text-rose-600 hover:underline cursor-pointer", title: "Remover esta imagem" do %>
                    ✕
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <div>
        <%= f.file_field :images, multiple: true, accept: "image/jpeg,image/png,image/webp", class: "w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer" %>
        <p class="text-[11px] text-slate-400 mt-1">Formatos aceitos: JPEG, PNG, WebP (máximo 5MB cada foto).</p>
      </div>
    </div>
  </div>

  <div class="pt-6 border-t border-slate-200 flex items-center justify-end gap-3">
    <%= link_to "Cancelar", painel_services_path, class: "px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900" %>
    <%= f.submit service.persisted? ? "Salvar Alterações" : "Cadastrar Serviço", data: { turbo_submits_with: "Salvando..." }, class: "px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-xs transition cursor-pointer" %>
  </div>
<% end %>
