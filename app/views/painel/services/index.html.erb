<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-slate-900">Serviços Oferecidos</h1>
      <p class="text-xs text-slate-500 mt-0.5">Gerencie os serviços prestados aos clientes da região</p>
    </div>

    <%= link_to new_painel_service_path, class: "inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs shadow-sm transition" do %>
      <span>+ Adicionar Serviço</span>
    <% end %>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs">
    <% if @services.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50 text-[11px] font-bold uppercase tracking-wider text-slate-500">
              <th class="p-4">Serviço</th>
              <th class="p-4">Categoria</th>
              <th class="p-4">Valor Estimado</th>
              <th class="p-4">Modalidade</th>
              <th class="p-4">Status</th>
              <th class="p-4 text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-sm">
            <% @services.each do |service| %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="p-4">
                  <p class="font-bold text-slate-900"><%= service.name %></p>
                  <p class="text-xs text-slate-400">/servicos/<%= service.slug %></p>
                </td>
                <td class="p-4">
                  <span class="text-xs px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700 font-medium">
                    <%= service.category.name %>
                  </span>
                </td>
                <td class="p-4">
                  <p class="font-bold text-indigo-700"><%= service.formatted_price %></p>
                </td>
                <td class="p-4">
                  <% if service.home_service? %>
                    <span class="text-xs text-emerald-700 font-semibold">🏠 A domicílio</span>
                  <% else %>
                    <span class="text-xs text-slate-500">No local</span>
                  <% end %>
                </td>
                <td class="p-4">
                  <% if service.active? %>
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-600">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Ativo
                    </span>
                  <% else %>
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-slate-400">
                      <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span> Inativo
                    </span>
                  <% end %>
                </td>
                <td class="p-4 text-right">
                  <div class="inline-flex items-center gap-2">
                    <%= link_to "Ver", service_path(service), target: "_blank", class: "text-xs font-semibold text-slate-600 hover:text-indigo-600" %>
                    <%= link_to "Editar", edit_painel_service_path(service), class: "text-xs font-semibold text-indigo-600 hover:underline" %>
                    <%= button_to "Excluir", painel_service_path(service), method: :delete, data: { turbo_confirm: "Tem certeza que deseja excluir este serviço?" }, class: "text-xs font-semibold text-rose-600 hover:underline cursor-pointer" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="p-10 text-center">
        <p class="text-sm font-semibold text-slate-700">Nenhum serviço cadastrado ainda.</p>
        <p class="text-xs text-slate-400 mt-1 mb-4">Cadastre serviços para que clientes possam solicitar orçamentos.</p>
        <%= link_to "Cadastrar Primeiro Serviço", new_painel_service_path, class: "px-4 py-2 bg-indigo-600 text-white rounded-xl text-xs font-bold" %>
      </div>
    <% end %>
  </div>
</div>
