<tr id="<%= dom_id(service) %>" class="hover:bg-slate-50/80 transition group">
  <td class="p-4">
    <div class="flex items-center gap-3">
      <% if service.images.attached? %>
        <%= image_tag service.images.first, class: "w-12 h-12 rounded-xl object-cover border border-slate-200 shrink-0 bg-slate-50" %>
      <% else %>
        <div class="w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 text-sm shrink-0">
          🛠️
        </div>
      <% end %>
      <div>
        <p class="font-bold text-slate-900 leading-tight"><%= service.name %></p>
        <p class="text-[11px] text-slate-400 mt-0.5">/servicos/<%= service.slug %></p>
      </div>
    </div>
  </td>
  <td class="p-4">
    <span class="text-xs px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 font-medium">
      <%= service.category.name %>
    </span>
  </td>
  <td class="p-4 whitespace-nowrap">
    <p class="font-bold text-slate-900"><%= service.formatted_price %></p>
  </td>
  <td class="p-4 whitespace-nowrap">
    <% if service.home_service? %>
      <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200">
        🏠 A domicílio
      </span>
    <% else %>
      <span class="text-xs text-slate-500 font-medium">No estabelecimento</span>
    <% end %>
  </td>
  <td class="p-4 whitespace-nowrap">
    <div class="flex items-center gap-2">
      <% if service.active? %>
        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Ativo
        </span>
      <% else %>
        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-full border border-slate-200">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> Inativo
        </span>
      <% end %>

      <%= button_to toggle_active_painel_service_path(service), method: :patch, class: "text-[11px] font-bold text-slate-500 hover:text-indigo-600 bg-white hover:bg-slate-100 px-2 py-1 rounded-md border border-slate-200 transition cursor-pointer", title: service.active? ? "Desativar serviço" : "Ativar serviço" do %>
        <%= service.active? ? "Desativar" : "Ativar" %>
      <% end %>
    </div>
  </td>
  <td class="p-4 text-right whitespace-nowrap">
    <div class="inline-flex items-center gap-2">
      <% if service.active? %>
        <%= link_to service_path(service), target: "_blank", class: "p-1.5 text-slate-500 hover:text-indigo-600 hover:bg-slate-100 rounded-lg transition", title: "Ver no site público" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        <% end %>
      <% end %>
      <%= link_to edit_painel_service_path(service), class: "px-2.5 py-1.5 text-xs font-bold text-indigo-600 hover:text-indigo-800 hover:bg-indigo-50 rounded-lg transition" do %>
        Editar
      <% end %>
      <%= button_to painel_service_path(service), method: :delete, data: { turbo_confirm: "Tem certeza que deseja excluir o serviço '#{service.name}'?" }, class: "px-2.5 py-1.5 text-xs font-bold text-rose-600 hover:text-rose-800 hover:bg-rose-50 rounded-lg transition cursor-pointer" do %>
        Excluir
      <% end %>
    </div>
  </td>
</tr>
