<div class="max-w-2xl">
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
    <div>
      <%= link_to "← Voltar aos serviços", painel_services_path, class: "text-xs font-semibold text-indigo-600 hover:underline" %>
      <h1 class="text-2xl font-black text-slate-900 mt-2">Editar Serviço</h1>
      <p class="text-xs text-slate-500">Atualize valores ou condições do serviço</p>
    </div>

    <% if @service.active? %>
      <%= link_to service_path(@service), target: "_blank", class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition self-start" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
        <span>Ver no site público</span>
      <% end %>
    <% else %>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 text-slate-400 text-xs font-medium self-start" title="Ative o serviço para exibir no catálogo público">
        🔒 Inativo publicamente
      </span>
    <% end %>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs">
    <%= render "form", service: @service %>
  </div>
</div>
