<%= form_with model: [:painel, product], local: true, class: "space-y-6" do |f| %>
  <% if product.errors.any? %>
    <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm">
      <h3 class="font-bold mb-1">Corrija os erros abaixo:</h3>
      <ul class="list-disc list-inside text-xs space-y-0.5">
        <% product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-5">
    <div>
      <%= f.label :name, "Nome do Produto *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_field :name, required: true, placeholder: "Ex: Copo Térmico 473ml Preto", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      <p class="text-[11px] text-slate-400 mt-1">Coloque o nome como o cliente costuma pesquisar (marca, modelo, cor ou tamanho).</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :category_id, "Categoria do Produto *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.collection_select :category_id, Category.active.for_products.order(:name), :id, :name, { prompt: "Selecione a categoria" }, required: true, class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-white" %>
      </div>

      <div>
        <%= f.label :price, "Preço Normal (R$) *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.text_field :price, value: product.price.present? ? ('%.2f' % product.price).tr('.', ',') : nil, required: true, placeholder: "Ex: 79,90 ou 149,00", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
        <p class="text-[11px] text-slate-400 mt-1">Você pode digitar vírgula ou ponto (ex: 79,90).</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :promotional_price, "Preço Promocional (R$) (opcional)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.text_field :promotional_price, value: product.promotional_price.present? ? ('%.2f' % product.promotional_price).tr('.', ',') : nil, placeholder: "Ex: 59,90", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
        <p class="text-[11px] text-slate-400 mt-1">Preço com desconto. Deve ser menor que o preço normal.</p>
      </div>

      <div class="flex items-center pt-2 sm:pt-6">
        <label class="flex items-center gap-2.5 cursor-pointer select-none">
          <%= f.check_box :available, class: "w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300 cursor-pointer" %>
          <div>
            <span class="text-xs font-bold text-slate-800">Disponível em estoque</span>
            <p class="text-[11px] text-slate-500">Se desmarcado, o produto continuará no seu painel mas não aparecerá na busca pública.</p>
          </div>
        </label>
      </div>
    </div>

    <div>
      <%= f.label :description, "Descrição e Detalhes do Produto", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_area :description, rows: 4, placeholder: "Informe características técnicas, voltagem, cores disponíveis, garantia, itens inclusos...", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <!-- Images Section -->
    <div class="border-t border-slate-200 pt-5 space-y-3">
      <div class="flex items-center justify-between">
        <div>
          <%= f.label :images, "Fotos do Produto", class: "block text-xs font-bold uppercase tracking-wider text-slate-700" %>
          <p class="text-[11px] text-slate-400 mt-0.5">Adicione fotos reais para atrair mais compradores de Teixeira de Freitas</p>
        </div>
      </div>

      <!-- Currently Attached Images -->
      <% if product.images.attached? %>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <% product.images.each do |image| %>
            <div class="relative group rounded-xl border border-slate-200 overflow-hidden bg-slate-50">
              <%= image_tag image, class: "w-full h-28 object-cover" %>
              <div class="p-1.5 bg-white border-t border-slate-100 flex items-center justify-between">
                <span class="text-[10px] text-slate-400 truncate"><%= image.filename %></span>
                <% if product.persisted? %>
                  <%= link_to purge_image_painel_product_path(product, image_id: image.id), data: { turbo_method: :delete, turbo_confirm: "Deseja excluir esta foto?" }, class: "text-[11px] font-bold text-rose-600 hover:underline cursor-pointer", title: "Remover esta imagem" do %>
                    ✕
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <div>
        <%= f.file_field :images, multiple: true, accept: "image/jpeg,image/png,image/webp", class: "w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer" %>
        <p class="text-[11px] text-slate-400 mt-1">Formatos aceitos: JPEG, PNG, WebP (máximo 5MB cada foto).</p>
      </div>
    </div>
  </div>

  <div class="pt-6 border-t border-slate-200 flex items-center justify-end gap-3">
    <%= link_to "Cancelar", painel_products_path, class: "px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900" %>
    <%= f.submit product.persisted? ? "Salvar Alterações" : "Cadastrar Produto", data: { turbo_submits_with: "Salvando..." }, class: "px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-xs transition cursor-pointer" %>
  </div>
<% end %>
