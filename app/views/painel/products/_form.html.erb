<%= form_with model: [:painel, product], local: true, class: "space-y-6" do |f| %>
  <% if product.errors.any? %>
    <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm">
      <h3 class="font-bold mb-1">Corrija os erros abaixo:</h3>
      <ul class="list-disc list-inside text-xs space-y-0.5">
        <% product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4">
    <div>
      <%= f.label :name, "Nome do Produto *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_field :name, required: true, placeholder: "Ex: Copo Térmico 473ml", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :category_id, "Categoria *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.collection_select :category_id, Category.active.for_products.order(:name), :id, :name, { prompt: "Selecione a categoria" }, required: true, class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-white" %>
      </div>

      <div>
        <%= f.label :price, "Preço Normal (R$) *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.number_field :price, step: "0.01", min: "0", required: true, placeholder: "149.90", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :promotional_price, "Preço Promocional (R$) (opcional)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.number_field :promotional_price, step: "0.01", min: "0", placeholder: "119.90", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>

      <div class="flex items-center gap-6 pt-5">
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :available, class: "w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500" %>
          <span class="text-xs font-bold text-slate-700">Disponível em estoque</span>
        </label>

        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :featured, class: "w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500" %>
          <span class="text-xs font-bold text-slate-700">Destacar na loja</span>
        </label>
      </div>
    </div>

    <div>
      <%= f.label :description, "Descrição Completa", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_area :description, rows: 4, placeholder: "Descreva detalhes técnicos, cores, voltagem, marca, garantia...", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>
  </div>

  <div class="pt-6 border-t border-slate-200 flex items-center justify-end gap-3">
    <%= link_to "Cancelar", painel_products_path, class: "px-4 py-2 text-sm font-semibold text-slate-600 hover:text-slate-900" %>
    <%= f.submit product.persisted? ? "Salvar Alterações" : "Cadastrar Produto", class: "px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm rounded-xl shadow-sm transition cursor-pointer" %>
  </div>
<% end %>
