<div id="mobile_<%= dom_id(product) %>" class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs space-y-3">
  <div class="flex items-start gap-3">
    <% if product.images.attached? %>
      <%= image_tag product.images.first, class: "w-16 h-16 rounded-xl object-cover border border-slate-200 shrink-0 bg-slate-50" %>
    <% else %>
      <div class="w-16 h-16 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-400 text-xl shrink-0">
        📦
      </div>
    <% end %>

    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between gap-1">
        <span class="text-[10px] px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-semibold truncate">
          <%= product.category.name %>
        </span>
        <% if product.available? %>
          <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">
            Disponível
          </span>
        <% else %>
          <span class="text-[10px] font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full">
            Indisponível
          </span>
        <% end %>
      </div>

      <h3 class="font-bold text-slate-900 text-sm mt-1 leading-snug truncate"><%= product.name %></h3>

      <div class="mt-1 flex items-baseline gap-2">
        <span class="text-sm font-black text-slate-900"><%= format_currency(product.current_price) %></span>
        <% if product.on_sale? %>
          <span class="text-[11px] text-slate-400 line-through"><%= format_currency(product.price) %></span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2">
    <%= button_to toggle_availability_painel_product_path(product), method: :patch, class: "text-xs font-bold px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 transition cursor-pointer" do %>
      <%= product.available? ? "Marcar Indisponível" : "Marcar Disponível" %>
    <% end %>

    <div class="flex items-center gap-1">
      <% if product.available? %>
        <%= link_to product_path(product), target: "_blank", class: "p-2 text-slate-500 hover:text-indigo-600 rounded-lg", title: "Ver público" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        <% end %>
      <% end %>
      <%= link_to "Editar", edit_painel_product_path(product), class: "text-xs font-bold text-indigo-600 hover:text-indigo-800 px-2 py-1" %>
      <%= button_to "Excluir", painel_product_path(product), method: :delete, data: { turbo_confirm: "Tem certeza que deseja excluir '#{product.name}'?" }, class: "text-xs font-bold text-rose-600 hover:text-rose-800 px-2 py-1 cursor-pointer" %>
    </div>
  </div>
</div>
