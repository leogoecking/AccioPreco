<div class="max-w-2xl">
  <div class="mb-6">
    <%= link_to "← Voltar aos produtos", painel_products_path, class: "text-xs font-semibold text-indigo-600 hover:underline" %>
    <h1 class="text-2xl font-black text-slate-900 mt-2">Editar Produto: <%= @product.name %></h1>
    <p class="text-xs text-slate-500">Atualize informações ou altere valores promocionais</p>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs">
    <%= render "form", product: @product %>
  </div>
</div>
