<% if @business %>
  <div class="max-w-4xl space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-black text-slate-900"><%= @business.name %></h1>
        <p class="text-xs text-slate-500 mt-0.5">Informações cadastrais e perfil da sua empresa</p>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to "Ver Perfil Público", business_path(@business), target: "_blank", class: "px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition" %>
        <%= link_to "Editar Informações", edit_painel_business_path, class: "px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-xs transition" %>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Tipo de Negócio</h3>
          <p class="text-sm font-semibold text-slate-800 mt-1">
            <%= @business.business_type == 'store' ? 'Loja de Produtos' : (@business.business_type == 'service_provider' ? 'Prestador de Serviços' : 'Ambos (Produtos e Serviços)') %>
          </p>
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Status de Verificação</h3>
          <p class="text-sm font-semibold mt-1">
            <% if @business.verified? %>
              <span class="text-emerald-600">✓ Verificado</span>
            <% else %>
              <span class="text-slate-500">Aguardando verificação</span>
            <% end %>
          </p>
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">WhatsApp</h3>
          <p class="text-sm font-semibold text-slate-800 mt-1"><%= @business.whatsapp.presence || "Não informado" %></p>
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Telefone Fixo</h3>
          <p class="text-sm font-semibold text-slate-800 mt-1"><%= @business.phone.presence || "Não informado" %></p>
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">E-mail</h3>
          <p class="text-sm font-semibold text-slate-800 mt-1"><%= @business.email.presence || "Não informado" %></p>
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Instagram</h3>
          <p class="text-sm font-semibold text-slate-800 mt-1"><%= @business.instagram.presence || "Não informado" %></p>
        </div>

        <div class="sm:col-span-2">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Endereço Completo</h3>
          <p class="text-sm font-semibold text-slate-800 mt-1"><%= @business.full_address.presence || "Não informado" %></p>
        </div>

        <div class="sm:col-span-2">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Descrição do Negócio</h3>
          <p class="text-sm text-slate-700 mt-1 leading-relaxed"><%= @business.description.presence || "Nenhuma descrição informada." %></p>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <div class="bg-white rounded-3xl border border-slate-200 p-8 text-center max-w-lg mx-auto">
    <h2 class="text-xl font-bold text-slate-900 mb-2">Nenhuma empresa cadastrada</h2>
    <p class="text-xs text-slate-500 mb-6">Cadastre sua primeira empresa para gerenciar produtos e serviços.</p>
    <%= link_to "Cadastrar Empresa", new_painel_business_path, class: "px-5 py-2.5 bg-indigo-600 text-white rounded-xl font-bold text-xs" %>
  </div>
<% end %>
