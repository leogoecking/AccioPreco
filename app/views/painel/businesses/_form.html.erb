<%= form_with model: [:painel, business], local: true, class: "space-y-6" do |f| %>
  <% if business.errors.any? %>
    <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm">
      <h3 class="font-bold mb-1">Corrija os erros abaixo:</h3>
      <ul class="list-disc list-inside text-xs space-y-0.5">
        <% business.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="md:col-span-2">
      <%= f.label :name, "Nome da Empresa ou Profissional *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_field :name, required: true, placeholder: "Ex: Clima Sul Refrigeração", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <div class="md:col-span-2">
      <%= f.label :description, "Descrição do Estabelecimento", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_area :description, rows: 3, placeholder: "Conte o que sua empresa oferece, especialidades, marcas trabalhadas...", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :business_type, "Tipo de Atuação *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.select :business_type, [["Loja de Produtos", "store"], ["Prestador de Serviços", "service_provider"], ["Ambos (Produtos & Serviços)", "both"]], {}, class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-white" %>
    </div>

    <div>
      <%= f.label :whatsapp, "WhatsApp para Contato (com DDD) *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_field :whatsapp, placeholder: "Ex: 73999998888", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :phone, "Telefone Fixo / Adicional", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_field :phone, placeholder: "Ex: 7332910000", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :email, "E-mail de Contato", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.email_field :email, placeholder: "contato@empresa.com.br", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :instagram, "Instagram", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_field :instagram, placeholder: "@suaempresa", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :neighborhood, "Bairro", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_field :neighborhood, placeholder: "Ex: Centro, Bela Vista, Monte Castelo", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <div class="md:col-span-2 grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="sm:col-span-2">
        <%= f.label :address, "Logradouro (Rua/Avenida)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.text_field :address, placeholder: "Ex: Av. Getúlio Vargas", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :number, "Número", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.text_field :number, placeholder: "Ex: 1250", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>
    </div>

    <div>
      <%= f.label :city, "Cidade *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_field :city, required: true, class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-slate-50" %>
    </div>

    <div>
      <%= f.label :state, "Estado *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_field :state, required: true, class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-slate-50" %>
    </div>
  </div>

  <div class="pt-6 border-t border-slate-200 flex items-center justify-end gap-3">
    <%= link_to "Cancelar", painel_path, class: "px-4 py-2 text-sm font-semibold text-slate-600 hover:text-slate-900" %>
    <%= f.submit business.persisted? ? "Atualizar Empresa" : "Cadastrar Empresa", class: "px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm rounded-xl shadow-sm transition cursor-pointer" %>
  </div>
<% end %>
