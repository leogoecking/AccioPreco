<%= form_with model: business, url: painel_business_path, local: true, class: "space-y-8" do |f| %>
  <% if business.errors.any? %>
    <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm">
      <h3 class="font-bold mb-1">Corrija os erros abaixo:</h3>
      <ul class="list-disc list-inside text-xs space-y-0.5">
        <% business.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Section 1: Informações Básicas -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-4">
    <div class="border-b border-slate-100 pb-3">
      <h3 class="text-sm font-black text-slate-900">Informações Básicas</h3>
      <p class="text-xs text-slate-500">Dados fundamentais para identificação do seu estabelecimento</p>
    </div>

    <div>
      <%= f.label :name, "Nome da Empresa ou Profissional *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_field :name, required: true, placeholder: "Ex: Clima Sul Refrigeração", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :business_type, "Tipo de Atuação Comercial *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.select :business_type, [["Loja de Produtos", "store"], ["Prestador de Serviços", "service_provider"], ["Ambos (Produtos & Serviços)", "both"]], {}, class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-white" %>
      <p class="text-[11px] text-slate-400 mt-1">Define como seu negócio é classificado nos filtros de busca da cidade.</p>
    </div>

    <div>
      <%= f.label :description, "Descrição do Estabelecimento", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
      <%= f.text_area :description, rows: 4, placeholder: "Conte o que sua empresa oferece, especialidades, marcas atendidas, formas de pagamento...", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      <p class="text-[11px] text-slate-400 mt-1">Uma descrição rica ajuda seu negócio a aparecer em mais termos de busca.</p>
    </div>
  </div>

  <!-- Section 2: Identidade Visual -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-6">
    <div class="border-b border-slate-100 pb-3">
      <h3 class="text-sm font-black text-slate-900">Identidade Visual</h3>
      <p class="text-xs text-slate-500">Imagens que aparecem no seu perfil e nas páginas de produtos</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Logo Upload -->
      <div class="space-y-3">
        <%= f.label :logo, "Logotipo / Foto de Perfil", class: "block text-xs font-bold uppercase tracking-wider text-slate-700" %>
        
        <% if business.logo.attached? %>
          <div class="flex items-center gap-4 p-3 bg-slate-50 rounded-xl border border-slate-200">
            <%= image_tag business.logo, class: "w-16 h-16 rounded-xl object-cover border border-slate-300 bg-white" %>
            <div class="flex-1 min-w-0">
              <p class="text-xs font-bold text-slate-800 truncate"><%= business.logo.filename %></p>
              <p class="text-[10px] text-slate-400"><%= number_to_human_size(business.logo.byte_size) %></p>
              <% if business.persisted? %>
                <%= link_to "Remover logotipo", purge_logo_painel_business_path, data: { turbo_method: :delete, turbo_confirm: "Deseja remover o logotipo atual?" }, class: "text-[11px] font-bold text-rose-600 hover:underline mt-1 cursor-pointer inline-block" %>
              <% end %>
            </div>
          </div>
        <% end %>

        <div>
          <%= f.file_field :logo, accept: "image/jpeg,image/png,image/webp", class: "w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer" %>
          <p class="text-[11px] text-slate-400 mt-1">Recomendado: imagem quadrada, JPEG, PNG ou WebP até 3MB.</p>
        </div>
      </div>

      <!-- Banner Upload -->
      <div class="space-y-3">
        <%= f.label :banner, "Banner de Capa", class: "block text-xs font-bold uppercase tracking-wider text-slate-700" %>

        <% if business.banner.attached? %>
          <div class="space-y-2 p-3 bg-slate-50 rounded-xl border border-slate-200">
            <%= image_tag business.banner, class: "w-full h-24 rounded-lg object-cover border border-slate-300 bg-white" %>
            <div class="flex items-center justify-between">
              <span class="text-[10px] text-slate-400"><%= number_to_human_size(business.banner.byte_size) %></span>
              <% if business.persisted? %>
                <%= link_to "Remover banner", purge_banner_painel_business_path, data: { turbo_method: :delete, turbo_confirm: "Deseja remover o banner atual?" }, class: "text-[11px] font-bold text-rose-600 hover:underline cursor-pointer inline-block" %>
              <% end %>
            </div>
          </div>
        <% end %>

        <div>
          <%= f.file_field :banner, accept: "image/jpeg,image/png,image/webp", class: "w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer" %>
          <p class="text-[11px] text-slate-400 mt-1">Recomendado: formato horizontal (1200x400), JPEG, PNG ou WebP até 5MB.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Section 3: Canais de Contato e Redes -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-4">
    <div class="border-b border-slate-100 pb-3">
      <h3 class="text-sm font-black text-slate-900">Canais de Contato & Redes Sociais</h3>
      <p class="text-xs text-slate-500">Por onde os clientes vão entrar em contato direto com você</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :whatsapp, "WhatsApp para Contato (com DDD) *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.text_field :whatsapp, placeholder: "Ex: (73) 99999-8888 ou 73999998888", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
        <p class="text-[11px] text-slate-400 mt-1">Número com DDD de Teixeira de Freitas (73) ou da sua região.</p>
      </div>

      <div>
        <%= f.label :phone, "Telefone Fixo / Adicional", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.text_field :phone, placeholder: "Ex: (73) 3291-0000", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :instagram, "Instagram (usuário ou link)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.text_field :instagram, placeholder: "Ex: @suaempresa ou link completo", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :email, "E-mail Comercial", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.email_field :email, placeholder: "contato@suaempresa.com.br", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>
    </div>
  </div>

  <!-- Section 4: Endereço Local -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-4">
    <div class="border-b border-slate-100 pb-3">
      <h3 class="text-sm font-black text-slate-900">Endereço e Localização Física</h3>
      <p class="text-xs text-slate-500">Para estabelecimentos com ponto de atendimento em Teixeira de Freitas</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="sm:col-span-2">
        <%= f.label :address, "Logradouro (Rua, Avenida, Praça)", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.text_field :address, placeholder: "Ex: Av. Getúlio Vargas", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :number, "Número", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.text_field :number, placeholder: "Ex: 1250 ou S/N", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :neighborhood, "Bairro", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.text_field :neighborhood, placeholder: "Ex: Centro, Bela Vista, Monte Castelo", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :postal_code, "CEP", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.text_field :postal_code, placeholder: "Ex: 45985-000", class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :city, "Cidade *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.text_field :city, required: true, class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-slate-50 font-medium" %>
      </div>

      <div>
        <%= f.label :state, "Estado *", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.text_field :state, required: true, class: "w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-slate-50 font-medium" %>
      </div>
    </div>
  </div>

  <div class="pt-4 flex items-center justify-end gap-3">
    <%= link_to "Cancelar", (business.persisted? ? painel_business_path : painel_path), class: "px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900" %>
    <%= f.submit business.persisted? ? "Salvar Alterações" : "Cadastrar Empresa", data: { turbo_submits_with: "Salvando..." }, class: "px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-xs transition cursor-pointer" %>
  </div>
<% end %>
