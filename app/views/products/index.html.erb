<% content_for :title, "Produtos em Teixeira de Freitas | Accio Preço" %>
<% content_for :meta_description, "Explore produtos à venda em lojas de Teixeira de Freitas - BA. Preços, detalhes e contato direto no WhatsApp." %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Produtos no Comércio Local</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">Consulte preços e compre direto com lojistas de Teixeira de Freitas</p>
    </div>

    <%= link_to search_path(type: "produtos"), class: "inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-indigo-50 text-indigo-700 hover:bg-indigo-100 text-xs font-bold transition" do %>
      <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <span>Pesquisar produtos</span>
    <% end %>
  </div>

  <% if @categories.any? %>
    <div class="mb-8 flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
      <span class="text-xs font-bold text-slate-400 shrink-0 mr-1">Filtrar:</span>
      <% @categories.each do |cat| %>
        <%= link_to cat.name, category_path(cat, type: "produtos"), class: "px-3 py-1.5 rounded-full text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:border-indigo-400 hover:text-indigo-600 transition shrink-0" %>
      <% end %>
    </div>
  <% end %>

  <% if @products.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @products.each do |product| %>
        <%= render "shared/product_card", product: product %>
      <% end %>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <%= render "shared/empty_state", title: "Nenhum produto cadastrado no momento", message: "Em breve novos produtos locais estarão disponíveis." %>
  <% end %>
</div>
