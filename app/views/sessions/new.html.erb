<div class="max-w-md mx-auto py-12 px-4 sm:px-6">
  <div class="bg-white rounded-3xl border border-slate-200 p-8 shadow-xs">
    <div class="text-center mb-8">
      <div class="w-12 h-12 rounded-2xl bg-indigo-600 text-white flex items-center justify-center font-black text-2xl mx-auto mb-3 shadow-md shadow-indigo-200">
        A
      </div>
      <h1 class="text-2xl font-black text-slate-900 tracking-tight">Área do Comerciante</h1>
      <p class="text-xs text-slate-500 mt-1">Acesse seu painel para gerenciar produtos, serviços e contatos</p>
    </div>

    <%= form_with url: session_url, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email_address, "E-mail cadastrado", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "seu@email.com", value: params[:email_address], class: "w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :password, "Senha", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" %>
        <%= f.password_field :password, required: true, autocomplete: "current-password", placeholder: "Sua senha", maxlength: 72, class: "w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
      </div>

      <div class="flex items-center justify-between pt-1">
        <%= link_to "Esqueceu a senha?", new_password_path, class: "text-xs font-semibold text-indigo-600 hover:underline" %>
      </div>

      <div class="pt-2">
        <%= f.submit "Entrar no Painel", class: "w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm rounded-xl shadow-md shadow-indigo-200 transition cursor-pointer" %>
      </div>
    <% end %>

    <div class="mt-8 pt-6 border-t border-slate-100 text-center">
      <p class="text-xs text-slate-400">Credenciais para teste local (seeds):</p>
      <p class="text-xs font-mono text-slate-600 mt-1">comerciante@techhouse.com / senha123</p>
      <p class="text-xs font-mono text-slate-600">admin@acciopreco.com / admin123</p>
    </div>
  </div>
</div>
