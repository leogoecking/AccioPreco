<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-slate-100">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Painel do Comerciante | Accio Preço" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full flex flex-col font-sans text-slate-900 antialiased" data-controller="mobile-menu">
    <!-- Painel Topbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
      <div class="px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-4">
            <button type="button" data-action="click->mobile-menu#toggle" class="lg:hidden p-2 rounded-lg text-slate-500 hover:bg-slate-100" aria-label="Menu lateral">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
            </button>

            <%= link_to painel_path, class: "flex items-center gap-2" do %>
              <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-black text-base">
                A
              </div>
              <span class="text-lg font-bold tracking-tight text-slate-900">
                Accio<span class="text-indigo-600">Preço</span>
              </span>
              <span class="text-xs px-2 py-0.5 font-medium bg-slate-100 text-slate-600 rounded-md border border-slate-200">
                Painel
              </span>
            <% end %>
          </div>

          <div class="flex items-center gap-3">
            <%= link_to root_path, target: "_blank", class: "hidden sm:inline-flex items-center gap-1.5 text-xs font-medium text-slate-600 hover:text-indigo-600 bg-slate-50 hover:bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200 transition" do %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
              Ver site público
            <% end %>

            <div class="flex items-center gap-2 pl-2 border-l border-slate-200">
              <div class="text-right hidden sm:block">
                <p class="text-xs font-bold text-slate-800"><%= current_user.name %></p>
                <p class="text-[10px] text-slate-500"><%= current_user.email_address %></p>
              </div>
              <%= button_to logout_path, method: :delete, class: "p-2 rounded-lg text-slate-500 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer", title: "Encerrar sessão" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="flex-1 flex overflow-hidden">
      <!-- Sidebar Desktop & Mobile -->
      <aside data-mobile-menu-target="menu" class="hidden lg:block w-64 bg-white border-r border-slate-200 shrink-0 flex flex-col justify-between p-4 fixed lg:static inset-y-16 left-0 z-20 shadow-lg lg:shadow-none">
        <div class="space-y-6">
          <!-- Active Business Badge -->
          <% if @current_business %>
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-200">
              <p class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Estabelecimento</p>
              <p class="font-bold text-slate-800 text-sm truncate"><%= @current_business.name %></p>
              <p class="text-xs text-slate-500 truncate"><%= @current_business.city %> - <%= @current_business.state %></p>
            </div>
          <% else %>
            <div class="p-3 bg-amber-50 rounded-xl border border-amber-200">
              <p class="text-xs font-semibold text-amber-800">Nenhuma empresa associada</p>
              <%= link_to "Cadastrar empresa", new_painel_business_path, class: "text-xs font-bold text-amber-900 underline block mt-1" %>
            </div>
          <% end %>

          <!-- Navigation Links -->
          <nav class="space-y-1">
            <%= link_to painel_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-semibold #{current_page?(painel_path) ? 'bg-indigo-50 text-indigo-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'}" do %>
              <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
              </svg>
              Visão Geral
            <% end %>

            <%= link_to painel_business_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-semibold #{current_page?(painel_business_path) ? 'bg-indigo-50 text-indigo-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'}" do %>
              <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              Minha Empresa
            <% end %>

            <%= link_to painel_products_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-semibold #{current_page?(painel_products_path) ? 'bg-indigo-50 text-indigo-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'}" do %>
              <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
              </svg>
              Produtos
            <% end %>

            <%= link_to painel_services_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-semibold #{current_page?(painel_services_path) ? 'bg-indigo-50 text-indigo-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'}" do %>
              <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              Serviços
            <% end %>

            <%= link_to painel_leads_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-semibold #{current_page?(painel_leads_path) ? 'bg-indigo-50 text-indigo-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'}" do %>
              <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
              Contatos / Leads
            <% end %>
          </nav>
        </div>

        <div class="pt-4 border-t border-slate-200 text-xs text-slate-400">
          Accio Preço · Teixeira de Freitas
        </div>
      </aside>

      <!-- Main Panel View -->
      <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
        <!-- Flash notifications inside panel -->
        <% if notice.present? || alert.present? %>
          <div class="mb-6 space-y-3">
            <% if notice.present? %>
              <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-2 shadow-sm">
                <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span><%= notice %></span>
              </div>
            <% end %>

            <% if alert.present? %>
              <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-2 shadow-sm">
                <svg class="w-5 h-5 text-rose-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                <span><%= alert %></span>
              </div>
            <% end %>
          </div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
