<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-slate-50">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Accio Preço | Encontre o que precisa em Teixeira de Freitas - BA" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%= content_for(:meta_description) || "Encontre produtos, serviços e empresas locais em Teixeira de Freitas e região. Conexão direta via WhatsApp sem complicação." %>">
    
    <!-- Open Graph -->
    <meta property="og:title" content="<%= content_for(:title) || "Accio Preço" %>">
    <meta property="og:description" content="<%= content_for(:meta_description) || "Encontre produtos, serviços e empresas locais em Teixeira de Freitas." %>">
    <meta property="og:type" content="website">
    
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Accio Preço">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full flex flex-col font-sans text-slate-900 antialiased selection:bg-indigo-500 selection:text-white">
    <!-- Navbar -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200" data-controller="mobile-menu">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <!-- Logo & Local Badge -->
          <div class="flex items-center gap-3">
            <%= link_to root_path, class: "flex items-center gap-2 group" do %>
              <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-black text-lg shadow-sm shadow-indigo-200 group-hover:bg-indigo-700 transition">
                A
              </div>
              <div class="flex flex-col">
                <span class="text-xl font-bold tracking-tight text-slate-900 group-hover:text-indigo-600 transition">
                  Accio<span class="text-indigo-600">Preço</span>
                </span>
                <span class="text-[10px] font-semibold text-slate-500 -mt-1 hidden sm:inline-block">
                  Teixeira de Freitas · BA
                </span>
              </div>
            <% end %>
            <span class="hidden md:inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200/60 ml-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>
              Comércio Local
            </span>
          </div>

          <!-- Desktop Navigation -->
          <nav class="hidden md:flex items-center space-x-6 text-sm font-medium">
            <%= link_to "Início", root_path, class: "text-slate-600 hover:text-indigo-600 transition" %>
            <%= link_to "Produtos", products_path, class: "text-slate-600 hover:text-indigo-600 transition" %>
            <%= link_to "Serviços", services_path, class: "text-slate-600 hover:text-indigo-600 transition" %>
            <%= link_to "Empresas", businesses_path, class: "text-slate-600 hover:text-indigo-600 transition" %>
          </nav>

          <!-- Auth & Action -->
          <div class="hidden md:flex items-center gap-3">
            <% if authenticated? %>
              <%= link_to painel_path, class: "inline-flex items-center gap-2 px-3.5 py-1.5 text-sm font-semibold rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 transition" do %>
                <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
                Painel
              <% end %>
              <%= button_to logout_path, method: :delete, class: "text-xs text-slate-500 hover:text-red-600 font-medium px-2 py-1 transition cursor-pointer" do %>
                Sair
              <% end %>
            <% else %>
              <%= link_to login_path, class: "inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-lg text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200/80 transition" do %>
                Área do Comerciante
              <% end %>
            <% end %>
          </div>

          <!-- Mobile Hamburger Button -->
          <div class="flex items-center md:hidden">
            <button type="button" data-action="click->mobile-menu#toggle" class="p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none" aria-label="Abrir menu">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile Dropdown Menu -->
      <div data-mobile-menu-target="menu" class="hidden md:hidden border-b border-slate-200 bg-white px-4 pt-2 pb-4 space-y-2">
        <%= link_to "Início", root_path, class: "block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:bg-slate-100" %>
        <%= link_to "Produtos", products_path, class: "block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:bg-slate-100" %>
        <%= link_to "Serviços", services_path, class: "block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:bg-slate-100" %>
        <%= link_to "Empresas", businesses_path, class: "block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:bg-slate-100" %>
        <div class="pt-2 border-t border-slate-100">
          <% if authenticated? %>
            <%= link_to "Acessar Painel", painel_path, class: "block w-full text-center px-4 py-2 text-sm font-semibold rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 mb-2" %>
            <%= button_to "Sair", logout_path, method: :delete, class: "block w-full text-center px-4 py-1.5 text-xs font-medium text-slate-500 hover:text-red-600" %>
          <% else %>
            <%= link_to "Área do Comerciante (Entrar)", login_path, class: "block w-full text-center px-4 py-2 text-sm font-semibold rounded-lg bg-indigo-50 text-indigo-700 hover:bg-indigo-100" %>
          <% end %>
        </div>
      </div>
    </header>

    <!-- Flash Notifications -->
    <% if flash[:notice].present? || flash[:alert].present? %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 w-full">
        <% if flash[:notice].present? %>
          <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span><%= flash[:notice] %></span>
            </div>
          </div>
        <% end %>

        <% if flash[:alert].present? %>
          <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-rose-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
              </svg>
              <span><%= flash[:alert] %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Main Content -->
    <main class="flex-grow">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 mt-20 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="md:col-span-2 space-y-3">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-black text-base">
                A
              </div>
              <span class="text-lg font-bold text-white tracking-tight">Accio<span class="text-indigo-400">Preço</span></span>
            </div>
            <p class="text-sm text-slate-400 max-w-md leading-relaxed">
              O buscador hiperlocal que conecta consumidores a empresas, produtos e serviços em Teixeira de Freitas e região. Encontre rápido, chame no WhatsApp e compre local.
            </p>
            <div class="flex items-center gap-2 text-xs text-slate-500 pt-1">
              <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
              Foco inicial em Teixeira de Freitas - BA
            </div>
          </div>

          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-300 mb-3">Navegação</h4>
            <ul class="space-y-2 text-sm">
              <li><%= link_to "Início", root_path, class: "hover:text-white transition" %></li>
              <li><%= link_to "Produtos Locais", products_path, class: "hover:text-white transition" %></li>
              <li><%= link_to "Serviços e Profissionais", services_path, class: "hover:text-white transition" %></li>
              <li><%= link_to "Guia de Empresas", businesses_path, class: "hover:text-white transition" %></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-300 mb-3">Comerciantes</h4>
            <ul class="space-y-2 text-sm">
              <% if authenticated? %>
                <li><%= link_to "Meu Painel", painel_path, class: "hover:text-white transition" %></li>
                <li><%= link_to "Minha Empresa", painel_business_path, class: "hover:text-white transition" %></li>
                <li><%= link_to "Meus Produtos", painel_products_path, class: "hover:text-white transition" %></li>
                <li><%= link_to "Meus Serviços", painel_services_path, class: "hover:text-white transition" %></li>
              <% else %>
                <li><%= link_to "Acessar Painel", login_path, class: "hover:text-white transition" %></li>
                <li><span class="text-slate-500 text-xs">Divulgue seus produtos e serviços gratuitamente</span></li>
              <% end %>
            </ul>
          </div>
        </div>

        <div class="mt-10 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-3">
          <p>© <%= Date.current.year %> Accio Preço. Todos os direitos reservados.</p>
          <p>Feito para fortalecer o comércio de Teixeira de Freitas - BA.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
